<% content_for :title, "New Snippet — Halo" %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <%= link_to root_path, class: "inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors no-underline" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15m0 0l6.75 6.75M4.5 12l6.75-6.75" />
      </svg>
      Back to home
    <% end %>
  </div>

  <h1 class="font-heading text-3xl font-bold text-primary tracking-tight mb-8">New snippet</h1>

  <%= form_with model: @snippet, local: true, class: "space-y-6" do |f| %>
    <% if @snippet.errors.any? %>
      <div class="bg-destructive/10 text-destructive border border-destructive/30 rounded p-4 text-sm">
        <p class="font-semibold mb-1"><%= pluralize(@snippet.errors.count, "error") %> prevented this snippet from being saved:</p>
        <ul class="list-disc list-inside space-y-0.5">
          <% @snippet.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title, "Title (optional)", class: "block text-sm font-medium text-foreground mb-1.5" %>
      <%= f.text_field :title, placeholder: "e.g. Quick sort in Python", class: "w-full px-4 py-2.5 border border-border bg-card rounded text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:border-ring focus:ring-1 focus:ring-ring text-sm" %>
    </div>

    <div>
      <%= f.label :language, "Language (optional)", class: "block text-sm font-medium text-foreground mb-1.5" %>
      <%= f.select :language,
            Snippet::LANGUAGES.map { |l| [l.capitalize, l] },
            { include_blank: "Auto-detect / plain text" },
            { class: "w-full px-4 py-2.5 border border-border bg-card rounded text-foreground focus:outline-none focus:border-ring focus:ring-1 focus:ring-ring text-sm" } %>
    </div>

    <div>
      <%= f.label :content, "Code", class: "block text-sm font-medium text-foreground mb-1.5" %>
      <span class="text-destructive ml-1">*</span>
      <%= f.text_area :content,
            rows: 16,
            placeholder: "Paste your code here...",
            required: true,
            class: "w-full px-4 py-3 border border-border bg-card rounded text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:border-ring focus:ring-1 focus:ring-ring font-mono text-sm resize-y" %>
      <% if @snippet.errors[:content].any? %>
        <p class="text-destructive text-xs mt-1"><%= @snippet.errors[:content].join(", ") %></p>
      <% end %>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <%= f.submit "Create snippet", class: "px-5 py-2.5 bg-primary text-on-primary rounded font-medium text-sm hover:bg-primary/90 transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-ring border-0" %>
      <%= link_to "Cancel", root_path, class: "px-5 py-2.5 border border-border text-muted-foreground rounded font-medium text-sm hover:text-foreground hover:bg-muted transition-colors no-underline" %>
    </div>
  <% end %>
</div>
